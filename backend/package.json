{
  "name": "smartchat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js API for the SmartChat Android final project",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "npm run test:typecheck && tsx --test --test-concurrency=1 tests/unit/environment.test.ts tests/unit/openai.provider.test.ts tests/integration/health.routes.test.ts tests/integration/auth.routes.test.ts tests/integration/user.routes.test.ts tests/integration/conversation.routes.test.ts tests/integration/message.routes.test.ts tests/integration/attachment.routes.test.ts tests/integration/ai.routes.test.ts",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.0.2",
    "openai": "^7.1.0",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
