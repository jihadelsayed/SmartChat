generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageSender {
  USER
  ASSISTANT
}

enum MessageRequestStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AttachmentStatus {
  PROCESSING
  UPLOADED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  displayName     String
  profileImageUrl String?
  conversations   Conversation[]
  messageRequests MessageRequest[]
  attachments     Attachment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Conversation {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  messages        Message[]
  messageRequests MessageRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, updatedAt])
}

model Message {
  id                      String          @id @default(uuid())
  conversationId          String
  conversation            Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                  MessageSender
  content                 String
  attachments             Attachment[]
  userMessageRequest      MessageRequest? @relation("MessageRequestUserMessage")
  assistantMessageRequest MessageRequest? @relation("MessageRequestAssistantMessage")
  createdAt               DateTime        @default(now())

  @@index([conversationId, createdAt])
}

model MessageRequest {
  id                 String               @id @default(uuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  idempotencyKey     String
  requestHash        String
  status             MessageRequestStatus
  userMessageId      String               @unique
  userMessage        Message              @relation("MessageRequestUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  assistantMessageId String?              @unique
  assistantMessage   Message?             @relation("MessageRequestAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  errorStatusCode    Int?
  errorCode          String?
  errorMessage       String?
  errorRetryable     Boolean?
  retryAfter         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([userId, conversationId, idempotencyKey])
  @@index([conversationId, status])
}

model Attachment {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientAttachmentId String
  messageId          String?
  message            Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status             AttachmentStatus
  fileName           String
  mimeType           String
  fileUrl            String
  sizeBytes          Int
  contentHash        String
  createdAt          DateTime         @default(now())

  @@unique([userId, clientAttachmentId])
  @@index([messageId])
  @@index([userId, createdAt])
}
